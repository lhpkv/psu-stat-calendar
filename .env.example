# Supabase — ค่าจาก Project Settings → API (ใช้ได้ทั้ง local และคลาวด์)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ใช้โดย live-sync (ฝั่ง server เท่านั้น)
# service_role key จาก Project Settings → API (ห้าม expose ให้ browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# คีย์เข้ารหัสรหัสผ่าน scmis — hex 64 ตัว (32 ไบต์) สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PSU_ENC_KEY=<hex-64>

# Deploy Vercel: ต้อง set ทั้ง 4 ตัวนี้ (Production + Preview) — NEXT_PUBLIC_* ถูกฝังใน bundle ตอน build
